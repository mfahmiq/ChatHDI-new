# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_PUBLIC_URL=http://localhost:3000

# Server-side AI providers (never prefix secret keys with NEXT_PUBLIC_)
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MAX_TOKENS=4096
NVIDIA_REQUESTS_PER_MINUTE=40
NVIDIA_MAX_CONCURRENT_REQUESTS=4
NVIDIA_MAX_QUEUE_SIZE=200
NVIDIA_IMAGE_TIMEOUT_MS=120000
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
GEMINI_API_KEY=

# Local Ollama / RAG
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_EMBEDDING_DIMENSIONS=384
RAG_LOCAL_TOP_K=4
RAG_LOCAL_THRESHOLD=0.2
